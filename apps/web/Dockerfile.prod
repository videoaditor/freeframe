# Stage 1: Install dependencies
FROM node:20-alpine AS deps
RUN corepack enable && corepack prepare pnpm@10.15.0 --activate
WORKDIR /app
COPY package.json pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile

# Stage 2: Build the application
FROM node:20-alpine AS builder
RUN corepack enable && corepack prepare pnpm@10.15.0 --activate
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY . .

ARG NEXT_PUBLIC_API_URL=/api
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
ARG NEXT_PUBLIC_PASSWORD_LOGIN_ENABLED=true
ENV NEXT_PUBLIC_PASSWORD_LOGIN_ENABLED=$NEXT_PUBLIC_PASSWORD_LOGIN_ENABLED
# Base URL of the craft-review service behind the /handin route. Empty by
# default, which turns that route off - a self-hoster who is not Aditor gets no
# page pointing at Aditor's reviewer. Not a secret: it is a public hostname the
# browser calls directly, which is why it is a build arg and not an API secret.
ARG NEXT_PUBLIC_REVIEW_GATE_URL=
ENV NEXT_PUBLIC_REVIEW_GATE_URL=$NEXT_PUBLIC_REVIEW_GATE_URL
ARG NEXT_PUBLIC_SHARE_COMMENTS_COLLAPSED=false
ENV NEXT_PUBLIC_SHARE_COMMENTS_COLLAPSED=$NEXT_PUBLIC_SHARE_COMMENTS_COLLAPSED
# The label and placeholder for the link a FOLDER must carry, when an instance files each hand-in
# as a folder inside a per-brand project. Empty upstream, so the New Folder dialog keeps its single
# field everywhere else.
ARG NEXT_PUBLIC_FOLDER_LINK_LABEL=
ENV NEXT_PUBLIC_FOLDER_LINK_LABEL=$NEXT_PUBLIC_FOLDER_LINK_LABEL
ARG NEXT_PUBLIC_FOLDER_LINK_PLACEHOLDER=
ENV NEXT_PUBLIC_FOLDER_LINK_PLACEHOLDER=$NEXT_PUBLIC_FOLDER_LINK_PLACEHOLDER

# What an editor is told when an upload finishes, e.g. "Sent for review - feedback appears on the
# video in a few minutes." Empty upstream, so the line does not appear at all unless an instance
# sets it. Not a secret: it is a sentence shown in the browser.
ARG NEXT_PUBLIC_UPLOAD_REVIEW_NOTICE=
ENV NEXT_PUBLIC_UPLOAD_REVIEW_NOTICE=$NEXT_PUBLIC_UPLOAD_REVIEW_NOTICE

# Guest identities that are automations, not people. Empty upstream, so the badge behaves exactly
# as it always has unless an instance names one.
ARG NEXT_PUBLIC_AUTOMATION_GUEST_EMAILS=
ENV NEXT_PUBLIC_AUTOMATION_GUEST_EMAILS=$NEXT_PUBLIC_AUTOMATION_GUEST_EMAILS
ENV NEXT_TELEMETRY_DISABLED=1

RUN pnpm build

# Stage 3: Production runner
FROM node:20-alpine AS runner
WORKDIR /app

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV HOSTNAME=0.0.0.0
ENV PORT=3000

RUN addgroup --system --gid 1001 nodejs
RUN adduser --system --uid 1001 nextjs

COPY --from=builder /app/public ./public
COPY --from=builder --chown=nextjs:nodejs /app/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/.next/static ./.next/static

USER nextjs

EXPOSE 3000

CMD ["node", "server.js"]
